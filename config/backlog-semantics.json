{
  "schema": "sentinel-shield/backlog-semantics@1",
  "purpose": "The single declared mapping between the GitHub label taxonomy and config/remediation-plan.json. tests/prod/112 reads ONLY this file to decide what agreement means; no label-to-plan translation is written into shell conditionals.",
  "why": "The live half of 112 compared MEMBERSHIP alone — every open issue appears in the plan, no closed issue is listed as active work. It never compared status, so the authenticated backlog lane stayed green while #345 was status:partial live and status ready in the plan. Membership agreement is not semantic agreement, and this file is what makes the difference assertable.",
  "field_mapping": [
    {
      "field": "status",
      "live": "label",
      "label_prefix": "status:",
      "plan_key": "status",
      "normative": true,
      "note": "exactly one status label is required; the mapping below decides which plan status it means"
    },
    {
      "field": "priority",
      "live": "label",
      "label_prefix": "priority:",
      "plan_key": "priority",
      "normative": true
    },
    {
      "field": "type",
      "live": "label",
      "label_prefix": "type:",
      "plan_key": "type",
      "normative": true
    },
    {
      "field": "primary_domain",
      "live": "label",
      "label_prefix": "area:",
      "plan_key": "primary_domain",
      "normative": true,
      "note": "agrees for 175/175 planned open issues on master 7eb02d21, so it is enforced rather than merely recorded"
    },
    {
      "field": "milestone",
      "live": "milestone.title",
      "plan_key": "milestone_title",
      "normative": true,
      "note": "the plan carries both the short key and the title; the title is what GitHub exposes"
    }
  ],
  "non_normative": [
    {
      "field": "title",
      "reason": "editorial; the plan deliberately does not mirror issue prose"
    },
    {
      "field": "body",
      "reason": "editorial"
    },
    {
      "field": "assignees",
      "reason": "ownership is not modelled in the plan"
    },
    {
      "field": "labels with any other prefix",
      "reason": "not part of the plan schema; a new label prefix must be added here before it can be enforced"
    }
  ],
  "status_labels": {
    "status:ready": {
      "plan_status": "ready",
      "valid_for_open_planned_work": true
    },
    "status:blocked": {
      "plan_status": "blocked",
      "valid_for_open_planned_work": true
    },
    "status:partial": {
      "plan_status": "partial",
      "valid_for_open_planned_work": true
    },
    "status:in-progress": {
      "plan_status": "in-progress",
      "valid_for_open_planned_work": true
    },
    "status:needs-verification": {
      "plan_status": "needs-verification",
      "valid_for_open_planned_work": true
    },
    "status:deferred": {
      "plan_status": "deferred",
      "valid_for_open_planned_work": true
    },
    "status:verified": {
      "plan_status": null,
      "valid_for_open_planned_work": false,
      "reason": "verified work is CLOSED. The label on an open planned issue is itself drift, so it maps to no plan status rather than being silently accepted."
    }
  },
  "reconciliation_debt": {
    "why": "54 M4 records disagree in one direction only: the plan says ready, the label says blocked. Which side is authoritative is a RELEASE-OWNER decision, not a mechanical one, and it is not being guessed here. The plan's status is derived -- 112 already asserts that a record declaring blocked_by cannot be ready, and all 54 declare no blocked_by. The label is curated. So either the labels are stale, or the plan's blocked_by is incomplete for these records; parent epics 291 and 293 each appear on BOTH sides of the split, so no rule explains it.",
    "rules": [
      "An entry permits ONE named issue to disagree on ONE named field, and only for the exact (plan_value, live_value) pair recorded.",
      "An entry whose issue no longer disagrees on that field is STALE and fails, so the list can only shrink.",
      "An entry whose observed pair differs from the recorded pair fails, so drift changing shape is not absorbed.",
      "Drift on any (issue, field) not listed here fails. This list is not a policy, it is a named debt.",
      "Every entry carries a machine-readable reason, so the two debt classes below cannot be conflated."
    ],
    "surfaced_as": "#350",
