    "classes": {
      "authority-undetermined-m4-ready-vs-blocked": {
        "why": "54 M4 records disagree in one direction only: the plan says ready, the label says blocked. Which side is authoritative is a RELEASE-OWNER decision and is not being guessed. The plan's status is derived -- 112 already asserts that a record declaring blocked_by cannot be ready, and all 54 declare no blocked_by. The label is curated. So either the labels are stale, or the plan's blocked_by is incomplete for these records; parent epics 291 and 293 each appear on BOTH sides of the split, so no rule explains it.",
        "resolution": "a release-owner decision on which side is authoritative, tracked in #350, then a single reconciling change after which every entry in this class becomes stale and must be removed"
      }
    },
    "entry_contract": {
      "keyed_by": [
        "issue",
        "field"
      ],
      "required_fields": [
        "issue",
        "field",
        "plan_value",
        "live_value",
        "reason",
        "owner",
        "remediation",
        "created",
        "review_by",
        "source"
      ],
      "fails_when": [
        "the observed live value changes (debt-shape-changed)",
        "the plan value changes (debt-shape-changed)",
        "the mismatch disappears (debt-stale)",
        "the issue is no longer open (debt-not-live)",
        "the issue is no longer in the plan (debt-not-planned)",
        "the field is no longer normative (debt-field-not-normative)",
        "the review boundary is passed (debt-expired)",
        "a required field is absent (debt-incomplete)",
        "the reason names no declared class (debt-unknown-class)",
        "a declared class has no entries (debt-class-empty) — a discharged class is removed with its last entry, not kept as a slot",
        "review_by is not a real YYYY-MM-DD calendar date (debt-review-by-malformed) — a value the expiry comparison cannot order would never expire, which is the unbounded exception this contract forbids",
        "NOTE: a class carries no `count`. It was derived data that nothing asserted, so it could go stale silently; the entry list is the only source."
      ],
      "why": "Debt must not behave as a permanent allowlist. Every failure mode above turns an entry from an exception into an error, so an entry survives only while it remains exactly the mismatch it was written for, and only until its review boundary."
    }
  }
