      "issue": 96,
      "collector_issue": 135,
      "validator": "sc_syft_validate",
      "exit_vocabulary": {
        "0": "completed",
        "*": "operational"
      },
      "writes": "file-argument",
      "fakes": {
        "clean": "{\"spdxVersion\":\"SPDX-2.3\",\"name\":\"proj\",\"creationInfo\":{\"created\":\"2026-01-01T00:00:00Z\"},\"packages\":[]}",
        "findings": "{\"spdxVersion\":\"SPDX-2.3\",\"name\":\"proj\",\"creationInfo\":{\"created\":\"2026-01-01T00:00:00Z\"},\"packages\":[{\"name\":\"p\"}]}",
        "malformed": "{\"spdxVersion\":\"SPDX-2.3\",\"creat"
      },
      "findings_exit": 0,
      "expected": {
        "clean": "completed-clean",
        "findings": "completed-clean",
        "malformed": "execution-error",
        "fail": "execution-error",
        "missing": "unavailable"
      },
      "env": [],
      "setup_files": [],
      "semantics_note": "No findings state. An SBOM is an inventory, not a verdict -- a populated document is completed-clean exactly like an empty one. What distinguishes a real empty inventory from a forged `{}` is document metadata, not package count.",
      "no_findings_state": true
    },
