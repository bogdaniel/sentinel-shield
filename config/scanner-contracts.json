{
  "schema": "sentinel-shield/scanner-contract-table@1",
  "purpose": "The canonical description of every scanner adapter: its executor, output path, exit vocabulary and native report shapes. tests/prod/309 runs one data-driven conformance matrix over every row; tests/prod/308 proves the shared lifecycle once. A scanner is onboarded by adding a row, not by copying a suite.",
  "why": "Ten adapters were drifting toward ten implementations of one trust boundary. Ten bespoke end-to-end suites would have repeated that mistake in the tests.",
  "conformance_cases": [
    "completed-clean",
    "completed-findings",
    "missing-binary",
    "operational-failure",
    "malformed-output",
    "stale-cannot-survive",
    "no-temp-artifacts"
  ],
