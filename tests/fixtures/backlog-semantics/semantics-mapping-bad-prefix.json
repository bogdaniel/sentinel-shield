{
  "schema": "sentinel-shield/backlog-semantics@1",
  "purpose": "BROKEN FIXTURE, SINGLE FAULT: label_prefix for status is changed. The reconciler does not consume it for extraction, so it must REFUSE rather than silently compare the wrong thing.",
  "field_mapping": [
    {
      "field": "status",
      "live": "label",
      "label_prefix": "STATUSXX:",
      "plan_key": "status",
      "normative": true
    },
    {
      "field": "priority",
      "live": "label",
      "label_prefix": "priority:",
      "plan_key": "priority",
      "normative": true
    },
    {
      "field": "type",
      "live": "label",
      "label_prefix": "type:",
      "plan_key": "type",
      "normative": true
    },
    {
      "field": "primary_domain",
      "live": "label",
      "label_prefix": "area:",
      "plan_key": "primary_domain",
      "normative": true
    },
    {
      "field": "milestone",
      "live": "milestone.title",
      "plan_key": "milestone_title",
      "normative": true
    }
  ],
  "non_normative": [
    {
      "field": "title",
      "reason": "editorial"
    },
    {
      "field": "assignees",
      "reason": "not modelled"
    }
  ],
  "status_labels": {
    "status:ready": {
      "plan_status": "ready",
      "valid_for_open_planned_work": true
    },
    "status:blocked": {
      "plan_status": "blocked",
      "valid_for_open_planned_work": true
    },
    "status:partial": {
      "plan_status": "partial",
      "valid_for_open_planned_work": true
    },
    "status:in-progress": {
      "plan_status": "in-progress",
      "valid_for_open_planned_work": true
    },
    "status:needs-verification": {
      "plan_status": "needs-verification",
      "valid_for_open_planned_work": true
    },
    "status:deferred": {
      "plan_status": "deferred",
      "valid_for_open_planned_work": true
    },
    "status:verified": {
      "plan_status": null,
      "valid_for_open_planned_work": false,
      "reason": "verified work is CLOSED; the label on an open planned issue is itself drift"
    }
  },
  "reconciliation_debt": {
    "why": "fixture",
    "rules": [
      "fixture"
    ],
    "classes": {},
    "entries": []
  }
}
